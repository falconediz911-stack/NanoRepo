#!/usr/bin/python3
"""NanoOS GameMode privileged helper (run through pkexec).

Usage: nanoos-gamemode-helper <operation> <value>
       nanoos-gamemode-helper batch <operation>=<value> ...

  boost     0|1                       CPU turbo/boost
  governor  <name>                    cpufreq scaling governor, all policies
  epp       <name>                    energy/performance preference, all policies
  platform  <name>                    ACPI platform profile
  gpu       on|off                    NVIDIA persistence mode / amdgpu power level
  x3d       cache|frequency           AMD X3D: prefer the 3D V-Cache or the faster CCD
  batch     op=value [op=value ...]   several of the above in one call

Every value is checked against what the kernel advertises; nothing else
is ever written, and only the fixed sysfs files below are touched.
"""

import re
import shutil
import subprocess
import sys
from pathlib import Path

CPU = Path("/sys/devices/system/cpu")
BOOST_FILES = [CPU / "cpufreq/boost", CPU / "boost"]
INTEL_NO_TURBO = CPU / "intel_pstate/no_turbo"
PLATFORM_PROFILE = Path("/sys/firmware/acpi/platform_profile")
PLATFORM_CHOICES = Path("/sys/firmware/acpi/platform_profile_choices")
TOKEN = re.compile(r"[a-z0-9_-]{1,40}")
X3D_DRIVER = Path("/sys/bus/platform/drivers/amd_x3d_vcache")


def fail(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


def policies():
    return sorted((CPU / "cpufreq").glob("policy[0-9]*"))


def write_policies(attribute, available_attribute, value):
    written = 0
    for policy in policies():
        target = policy / attribute
        available = policy / available_attribute
        if not target.is_file():
            continue
        if available.is_file() and value not in available.read_text().split():
            fail(f"{value!r} is not supported by {policy.name} "
                 f"(supported: {available.read_text().strip()}).")
        target.write_text(value)
        written += 1
    if not written:
        fail(f"The kernel does not expose {attribute}.")


def amd_gpu_controls():
    return sorted(Path("/sys/class/drm").glob("card[0-9]*/device/power_dpm_force_performance_level"))


def apply(operation, value):
    """Apply one validated operation. Raises SystemExit via fail() on error."""
    if not TOKEN.fullmatch(value):
        fail("Invalid value.", 2)

    if operation == "boost":
        if value not in {"0", "1"}:
            fail("boost expects 0 or 1.", 2)
        for control in BOOST_FILES:
            if control.is_file():
                control.write_text(value)
                return
        if INTEL_NO_TURBO.is_file():
            INTEL_NO_TURBO.write_text("0" if value == "1" else "1")
            return
        fail("CPU boost control is not exposed by the kernel.")

    elif operation == "governor":
        write_policies("scaling_governor", "scaling_available_governors", value)

    elif operation == "epp":
        write_policies("energy_performance_preference",
                       "energy_performance_available_preferences", value)

    elif operation == "platform":
        if not PLATFORM_PROFILE.is_file():
            fail("This machine has no ACPI platform profile.")
        if PLATFORM_CHOICES.is_file() and value not in PLATFORM_CHOICES.read_text().split():
            fail(f"{value!r} is not an available platform profile.")
        PLATFORM_PROFILE.write_text(value)

    elif operation == "gpu":
        if value not in {"on", "off"}:
            fail("gpu expects on or off.", 2)
        done = False
        tool = shutil.which("nvidia-smi", path="/usr/bin:/usr/local/bin")
        if tool:
            # Persistence mode keeps the driver initialised: no clock ramp
            # or re-init hitch when a game starts.
            result = subprocess.run(
                [tool, "--persistence-mode=" + ("1" if value == "on" else "0")],
                capture_output=True, text=True,
            )
            if result.returncode != 0:
                fail((result.stderr or result.stdout).strip() or "nvidia-smi failed.")
            done = True
        for control in amd_gpu_controls():
            # amdgpu: hold the highest power state, or return to automatic.
            try:
                control.write_text("high" if value == "on" else "auto")
                done = True
            except OSError:
                pass  # some cards expose the file but reject manual levels
        if not done:
            fail("No supported GPU performance control was found.")

    elif operation == "x3d":
        # Dual-CCD X3D CPUs (7950X3D, 9950X3D, …): "cache" makes the
        # scheduler prefer the CCD with the 3D V-Cache, best for games.
        if value not in {"cache", "frequency"}:
            fail("x3d expects cache or frequency.", 2)
        controls = sorted(X3D_DRIVER.glob("*/amd_x3d_mode"))
        if not controls:
            fail("This CPU has no AMD X3D cache mode control.")
        for control in controls:
            control.write_text(value)

    else:
        fail(f"Unknown operation: {operation}", 2)


def main():
    if len(sys.argv) >= 3 and sys.argv[1] == "batch":
        # batch boost=1 governor=performance ...: one authorization for a
        # whole profile. Every step is attempted; failures are reported.
        problems = []
        for item in sys.argv[2:]:
            operation, sep, value = item.partition("=")
            if not sep:
                problems.append(f"{item}: expected operation=value")
                continue
            try:
                apply(operation, value.strip())
            except SystemExit:
                problems.append(f"{operation} failed")
            except OSError as exc:
                problems.append(f"{operation}: {exc}")
        if problems:
            fail("; ".join(problems))
        return

    if len(sys.argv) != 3:
        fail(__doc__.strip(), 2)
    apply(sys.argv[1], sys.argv[2].strip())


if __name__ == "__main__":
    try:
        main()
    except PermissionError as exc:
        fail(f"Permission denied: {exc}")
    except OSError as exc:
        fail(str(exc))
