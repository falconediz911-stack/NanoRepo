<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>NanoOS Project</vendor>
  <action id="org.nanoos.GameMode.helper">
    <description>Apply NanoOS GameMode performance settings</description>
    <message>Authentication is required to change CPU and GPU performance settings</message>
    <!-- The helper only writes validated values to CPU/GPU power controls,
         the same class of setting power-profiles-daemon lets a local user
         change, so a logged-in local session needs no password. -->
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/nanoos-gamemode/nanoos-gamemode-helper</annotate>
  </action>
</policyconfig>
