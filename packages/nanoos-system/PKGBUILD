package() {
  install -Dm644 nanoos.zshrc "$pkgdir/usr/share/nanoos-system/zshrc"
  # fastfetch on the Linux console (16 colours): logo + preset "nanoos-tty".
  install -Dm644 N-tty.txt "$pkgdir/usr/share/fastfetch/logos/N-tty.txt"
  install -Dm644 nanoos-tty.jsonc "$pkgdir/usr/share/fastfetch/presets/nanoos-tty.jsonc"
  install -Dm644 90-nanoos-network.conf "$pkgdir/usr/lib/sysctl.d/90-nanoos-network.conf"
  # Distribution logo: os-release says LOGO=nanoos (KDE About this System, Info Center).
  install -Dm644 nanoos.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/nanoos.svg"
  local size
  for size in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "nanoos-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/nanoos.png"
  done
  install -Dm644 nanoos-256.png "$pkgdir/usr/share/pixmaps/nanoos.png"
  install -Dm644 nanoos-fastfetch-modules.py "$pkgdir/usr/share/nanoos-system/nanoos-fastfetch-modules.py"
  install -Dm755 nanoos-grub-display "$pkgdir/usr/bin/nanoos-grub-display"
  install -Dm644 99-nanoos-grub.hook "$pkgdir/usr/share/libalpm/hooks/99-nanoos-grub.hook"
  install -Dm644 nanoos-grub-display.service "$pkgdir/usr/lib/systemd/system/nanoos-grub-display.service"
  install -dm755 "$pkgdir/usr/share/nanoos-system/grub"
  install -m644 nanoos-*.pf2 "$pkgdir/usr/share/nanoos-system/grub/"
}
