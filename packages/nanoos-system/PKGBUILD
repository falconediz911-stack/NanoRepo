pkgname=nanoos-system
pkgver=1.1.8
pkgrel=1
pkgdesc='NanoOS system updates: release identity and logo, dual-boot clock, fast mirrors, pacman tuning, preconfigured zsh, monitor-sized GRUB menu'
arch=('any')
url='https://nanoosproject.org'
license=('GPL-3.0-or-later')
depends=('python' 'grub' 'breeze-gtk' 'reflector' 'efibootmgr' 'util-linux' 'fastfetch'
         'zsh' 'zsh-autosuggestions' 'zsh-syntax-highlighting' 'zsh-completions')
install=nanoos-system.install
source=('nanoos.zshrc' 'N-tty.txt' 'nanoos-tty.jsonc' '90-nanoos-network.conf' 'nanoos.svg' 'nanoos-16.png' 'nanoos-22.png' 'nanoos-24.png' 'nanoos-32.png' 'nanoos-48.png' 'nanoos-64.png' 'nanoos-128.png' 'nanoos-256.png' 'nanoos-512.png' '99-nanoos-grub.hook' 'nanoos-fastfetch-modules.py' 'nanoos-grub-display' 'nanoos-grub-display.service' 'nanoos-bold-20.pf2' 'nanoos-bold-27.pf2' 'nanoos-bold-40.pf2' 'nanoos-regular-16.pf2' 'nanoos-regular-20.pf2' 'nanoos-regular-21.pf2' 'nanoos-regular-27.pf2' 'nanoos-regular-28.pf2' 'nanoos-regular-32.pf2' 'nanoos-regular-37.pf2' 'nanoos-regular-40.pf2' 'nanoos-regular-56.pf2')
sha256sums=('e761878ffc5c1e38c076f96ac67fd3ae0d50bdca12685403136c62ef3bf93bc8' 'ff495b13e1544b9950634124b7dac9767608b834b886a32acb784bab436c5a7c' 'ae711bace27219eea51c20bf1755bb45a784841e9c58a6eebfef30e6c2effe91' 'a1a1407c91bae2b7afe4b379dab9f539e01b7a9496f3d41047ca55d5e3536441' 'f619b4a9434ee8b95cefde4e872fbf258c0abb9114687a2fbcccd9821cde175b' 'c29de1f93b3fcf154c872793e3edac193a12e14b85058441893d12385df91d1a' '2b48c6c3fe65c346e0d0f7d3288004f2ed718780d786e5c870cd296ee873bc99' 'c8a6da9a822cdff9c06d5701d84c11f52e231ff91312e3416c94b800c8c50306' '2b1c4e772d85f413dc1ac825231085f0d2c9abe5655c81ea3e0bafb7ab8cfa97' 'd67aca062d8cf9e5cf0d0eb7c93f72a9018dd90e36df70fed0eac040710d13a7' '59509bd64a17f4f21a5122543d30eebb515dc6682083e5ca87e00d7c1a6150aa' '33db440d9de10bcd297948a2454ce670c1f10977c14d2e21ac2afd87b5863bcc' '3c6617359127b09a0c755041595768bfece58e8940700db46231ca1e6836ead4' 'ebb215f35cc9f9b0c67e64d37a08200182c5d7ff02ab83ca06505ac6b589aefa' '909bdef44d4d48a9d514395da8454aa5e026235f0a8fad8b273f12791698d88d' 'aa2b5d49d53eec545088ee0817ce2201990195685d9d53f551fbf630fa735b1a' '45794bff18d39329015edeb3bed1e561a93fbe3bbf102f401a01fa75353e0366' '4ce014aa662b413b2566eca8e9cb9fe2310e325c643304aa8a0283bfcde87d8f' '1536b0a0d7d8db9bc949d290aa12ecaa8741d627bbb80c3fb16b5d3e9202710f' 'b342275a77ba523beb8b38e60386d3afc7662f33576501afe4321ec0b33c37d3' '8edef8572009f6327e8007dc0f0efa849bb97e1f50495dd8a815e3103932e33e' '7390cc965dcbf86b4b2c8ed33e8603c9d8bc6870b7d70ea03da6de757645e77d' '2e557cd41995d739b24a4a137f6b3e461f3b5fae49572586b45f909227592a8b' 'bcb45c0bac7678bc119a0b7a4027296e625a66297f5101bbcbc246a1a5300bfe' 'c82170d6445abb96984d0d0447b4525948e4c626e769b8ea6f478b57001de05a' '73013e61ad101bc3b4bf1ccf60c42e5cc1834921b520609e22a1f290001028b2' '7243f15fb34783222c10751d279be0fd2738b4f053917446d63c1ce6a284c72f' 'c4a6da21a6e07915d7f4e6d47a9644ea45554a50d19e486af3b0754b28374ed7' '6088f9578901053ed935e24e40d8ee9b783c27be7a521f798150f2c39cf62aed' '8c8412bf76f641e91ff5ef1f681dc934b59d7a8334dd