# NanoOS system updates: brings existing installs up to the current release.
# Every step is idempotent and leaves user customisations alone.

_nanoos_edition() {
  sed -n 's/^NAME="\(.*\)"$/\1/p' /etc/os-release 2>/dev/null | head -1
}

# 1. Release identity (os-release written by the installer, owned by no package).
_nanoos_identity() {
  local f name version
  name=$(_nanoos_edition)
  case "$name" in
    "NanoOS Gaming"|"NanoOS") name="NanoOS Gaming"; version="1.1" ;;
    "NanoOS Basic") version="1.0" ;;
    *) return ;;
  esac
  for f in /etc/os-release /etc/nanoos-release; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    grep -q '^ID=nanoos$' "$f" || continue
    sed -i -e "s/^NAME=.*/NAME=\"$name\"/" \
           -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"$name $version\"/" \
           -e "s/^VERSION=.*/VERSION=\"$version\"/" \
           -e "s/^VERSION_ID=.*/VERSION_ID=\"$version\"/" "$f"
  done
}

# 2. Dual boot with Windows: hardware clock in local time.
_nanoos_windows_clock() {
  grep -qx 'LOCAL' /etc/adjtime 2>/dev/null && return
  local windows=0 esp
  efibootmgr 2>/dev/null | grep -q 'Windows Boot Manager' && windows=1
  for esp in /boot/efi /boot /efi; do
    [ -f "$esp/EFI/Microsoft/Boot/bootmgfw.efi" ] && windows=1
  done
  [ "$windows" = 1 ] || return
  hwclock --systohc --localtime 2>/dev/null &&
    echo ":: NanoOS: Windows found, hardware clock now in local time."
}

# 3. Fast, up-to-date mirrors.
_nanoos_mirrors() {
  local conf=/etc/xdg/reflector/reflector.conf
  if ! grep -q 'NanoOS' "$conf" 2>/dev/null; then
    mkdir -p /etc/xdg/reflector
    printf '%s\n' '# NanoOS: keep the 10 fastest, recently synced HTTPS mirrors.' \
      '--protocol https' '--age 12' '--latest 20' '--sort rate' '--number 10' \
      '--save /etc/pacman.d/mirrorlist' > "$conf"
  fi
  systemctl enable reflector.timer >/dev/null 2>&1
  if [ "$(grep -c '^Server' /etc/pacman.d/mirrorlist 2>/dev/null)" -gt 50 ]; then
    systemctl start --no-block reflector.service >/dev/null 2>&1 || true
  fi
}

# 4. pacman: 10 parallel downloads.
_nanoos_pacman() {
  local conf=/etc/pacman.conf
  grep -q '^ParallelDownloads = 10$' "$conf" && return
  if grep -q '^#\?ParallelDownloads' "$conf"; then
    sed -i 's/^#\?ParallelDownloads.*/ParallelDownloads = 10/' "$conf"
  else
    sed -i '/^\[options\]/a ParallelDownloads = 10' "$conf"
  fi
}

# 5. Preconfigured zsh: default for new users; existing users on plain bash
#    without their own ~/.zshrc get the NanoOS zsh too.
_nanoos_zsh() {
  local rc=/usr/share/nanoos-system/zshrc user home shell
  [ -f /etc/skel/.zshrc ] || install -Dm644 "$rc" /etc/skel/.zshrc
  if grep -q '^SHELL=' /etc/default/useradd 2>/dev/null; then
    sed -i 's|^SHELL=.*|SHELL=/usr/bin/zsh|' /etc/default/useradd
  else
    echo 'SHELL=/usr/bin/zsh' >> /etc/default/useradd
  fi
  while IFS=: read -r user _ uid _ _ home shell; do
    [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] && [ -d "$home" ] || continue
    case "$shell" in /bin/bash|/usr/bin/bash) ;; *) continue ;; esac
    [ -e "$home/.zshrc" ] && continue
    install -m644 -o "$user" -g "$(id -gn "$user")" "$rc" "$home/.zshrc"
    usermod -s /usr/bin/zsh "$user" &&
      echo ":: NanoOS: $user now uses the NanoOS zsh (log out and back in)."
  done < /etc/passwd
}

# 6. GRUB menu sized for the monitor (native resolution + scaled theme).
_nanoos_grub_display() {
  systemctl enable nanoos-grub-display.service >/dev/null 2>&1
  [ -f /boot/grub/themes/nanoos/theme.txt ] && /usr/bin/nanoos-grub-display || true
}

# 7. fastfetch: Display, Window Manager, Theme, Terminal Font, Local IP
#    (only NanoOS's own configs; colours of the user's theme are kept).
_nanoos_fastfetch() {
  local f
  for f in /etc/xdg/fastfetch/config.jsonc /etc/fastfetch/config.jsonc; do
    grep -q 'NanoOS' "$f" 2>/dev/null || continue
    grep -q '"terminalfont"' "$f" && continue
    python3 /usr/share/nanoos-system/nanoos-fastfetch-modules.py "$f" 2>/dev/null || true
  done
}

# 8. GRUB menu titled "NanoOS Gaming" (not "NanoOS Linux"): the packaged hook
#    in /usr/share/libalpm/hooks replaces the copy older installers put in /etc.
_nanoos_grub_hook() {
  local old=/etc/pacman.d/hooks/99-nanoos-grub.hook
  if [ -f "$old" ] && grep -q 'NanoOS: keep the GRUB boot menu' "$old" &&
     ! pacman -Qqo "$old" >/dev/null 2>&1; then
    rm -f "$old"
  fi
  [ -f /boot/grub/grub.cfg ] && /usr/bin/nanoos-grub-display --update >/dev/null 2>&1 || true
}

# 9. Performance: network tuning (packaged sysctl file, applied now),
#    boot without waiting for the network (once), Breeze-Dark GTK theme for
#    users still on the NanoOS default (Adwaita-dark).
_nanoos_performance() {
  sysctl --load=/usr/lib/sysctl.d/90-nanoos-network.conf >/dev/null 2>&1 || true
  local mark=/var/lib/nanoos/wait-online-disabled
  if [ ! -e "$mark" ]; then
    systemctl disable NetworkManager-wait-online.service >/dev/null 2>&1 || true
    mkdir -p /var/lib/nanoos && touch "$mark"
  fi
  local user home f
  while IFS=: read -r user _ uid _ _ home _; do
    [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] && [ -d "$home" ] || continue
    for f in "$home/.config/gtk-3.0/settings.ini" "$home/.config/gtk-4.0/settings.ini"; do
      [ -f "$f" ] && grep -qx 'gtk-theme-name=Adwaita-dark' "$f" || continue
      sed -i 's/^gtk-theme-name=Adwaita-dark$/gtk-theme-name=Breeze-Dark/' "$f"
    done
  done < /etc/passwd
}

# 10. Linux console: 16-colour fastfetch. Users whose ~/.zshrc is still the
#     unchanged NanoOS 1.1 default get the new default (TTY-aware).
_nanoos_zshrc_refresh() {
  local new=/usr/share/nanoos-system/zshrc user home rc
  [ -f /etc/skel/.zshrc ] && case "$(sha256sum < /etc/skel/.zshrc | cut -d' ' -f1)" in e808d08ad69e5b00cf567b371b16f5d85f8df878b57d0fc9c1116f7407c4adb9|fe4f579b6472832cce49ed1152d6a750089eba5d9dd08de3be4140721b9a434e) true;; *) false;; esac &&
    install -m644 "$new" /etc/skel/.zshrc
  while IFS=: read -r user _ uid _ _ home _; do
    [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || continue
    rc="$home/.zshrc"
    [ -f "$rc" ] || continue
    case "$(sha256sum < "$rc" | cut -d' ' -f1)" in e808d08ad69e5b00cf567b371b16f5d85f8df878b57d0fc9c1116f7407c4adb9|fe4f579b6472832cce49ed1152d6a750089eba5d9dd08de3be4140721b9a434e) ;; *) continue;; esac
    install -m644 -o "$user" -g "$(id -gn "$user")" "$new" "$rc"
  done < /etc/passwd
}

# 11. CPU Boost at boot: the unit was part of multi-user.target while ordered
#     after power-profiles-daemon (which starts after multi-user.target), so
#     systemd broke the cycle by dropping it and the saved mode never applied.
_nanoos_cpu_boost_unit() {
  local unit=/usr/lib/systemd/system/nanoos-cpu-boost.service
  [ -f "$unit" ] && ! pacman -Qqo "$unit" >/dev/null 2>&1 || return
  grep -q '^WantedBy=multi-user.target' "$unit" || return
  local enabled=0
  systemctl is-enabled -q nanoos-cpu-boost.service 2>/dev/null && enabled=1
  sed -i 's/^WantedBy=multi-user.target$/WantedBy=graphical.target/' "$unit"
  systemctl daemon-reload >/dev/null 2>&1
  if [ "$enabled" = 1 ]; then
    systemctl reenable nanoos-cpu-boost.service >/dev/null 2>&1
    systemctl start --no-block nanoos-cpu-boost.service >/dev/null 2>&1 || true
    echo ":: NanoOS: CPU Boost now applies at boot again."
  fi
}

# 12. Login screen: SDDM on Wayland needs a compositor; its default (weston)
#     is not installed, so it failed and fell back to X11 on every boot.
_nanoos_sddm_compositor() {
  local conf=/etc/sddm.conf.d/10-nanoos.conf
  [ -f "$conf" ] && grep -q '^DisplayServer=wayland' "$conf" || return
  grep -q '^CompositorCommand=' "$conf" && return
  if command -v kwin_wayland >/dev/null; then
    printf '\n[Wayland]\nCompositorCommand=kwin_wayland --drm --no-lockscreen --no-global-shortcuts --locale1\n' >> "$conf"
  else
    sed -i 's/^DisplayServer=wayland$/DisplayServer=x11/' "$conf"
  fi
}

_nanoos_update() {
  _nanoos_identity
  _nanoos_windows_clock
  _nanoos_mirrors
  _nanoos_pacman
  _nanoos_zsh
  _nanoos_grub_display
  _nanoos_fastfetch
  _nanoos_grub_hook
  _nanoos_performance
  _nanoos_zshrc_refresh
  _nanoos_cpu_boost_unit
  _nanoos_sddm_compositor
}

post_install() { _nanoos_update; }
post_upgrade() { _nanoos_update; }
